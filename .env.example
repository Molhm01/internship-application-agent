# Copy to .env and adjust as needed, or set these in your shell before starting the server.
# The server reads process.env directly; there is no dotenv loader.

# Listening port. The host is always 127.0.0.1 and is not configurable.
AGENT_PORT=4317

# Overrides the generated token in local-data/agent-token.txt. This is the
# canonical secret shared with Internship-AI's INTERNSHIP_AGENT_TOKEN env var
# — if you set one here, set the identical value there (or vice versa).
# AGENT_TOKEN is accepted too, as a same-repo alias.
# INTERNSHIP_AGENT_TOKEN=

# Root for the database, logs, and documents.
AGENT_DATA_DIR=local-data

# debug | info | warn | error
AGENT_LOG_LEVEL=info

# Allow http://127.0.0.1 and http://localhost web origins (tests, docs examples).
AGENT_ALLOW_LOCAL_ORIGINS=true

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
