{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "dev:server",
      "type": "npm",
      "script": "dev:server",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev:extension",
      "type": "npm",
      "script": "dev:extension",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "validate",
      "type": "npm",
      "script": "validate",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc", "$eslint-stylish"]
    }
  ]
}
