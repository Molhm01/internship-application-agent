{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/agent-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--experimental-strip-types", "src/index.ts"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Vitest current file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vitest", "run", "${relativeFile}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
